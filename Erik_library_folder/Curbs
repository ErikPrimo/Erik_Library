			0.05, -0.20,  1,
			0.05, -0.08,  1,
			-0.05, -0.08, -1
		ELSE
			POLY2_B 4, 1+2+4,
				19, 0,
				0.5+0.2, -0.20,  1,
				0.8+0.2,  0.00,  1,
				0.5+0.2,  0.20,  1,
				0.5+0.2, -0.20, -1
		ENDIF
		DEL 1 
		IF Directions < -ESP THEN DEL 1
	ENDIF
