<![CDATA[
MATERIAL Asfalt
RESOL 128
BREAKPOINT 1

ROTZ ObjectAngle

!---Directions HotSpot--------------------------------------------------------------------------------------------------------------------------------------------------------------
GOSUB "DirectionsHotSpot"
!-----------------------------------------------------------------------------------------------------------------------------------------------------------------

!-------Main Loop Places All Objects------------------------------------------------------------------------------------------------------------------------------
GOSUB "FirstStraight"
i = 1
GOSUB "StraightHotSpot"
IF NextLength[1] = 0 AND CurveLeft[1] = 0 AND CurveRight[1] = 0 THEN
	IF Directions > ESP  THEN GOSUB "RightHotSpot"
	IF Directions < -ESP THEN GOSUB "LeftHotSpot"
ENDIF
WHILE ObjectOrder[i] <> 0 DO
	IF NextLength[i] > ESP 		 THEN ObjectOrder[i+1] = 2
	IF CurveLeft[i]  > ESP 		 THEN ObjectOrder[i+1] = 3
	IF CurveRight[i] > ESP 		 THEN ObjectOrder[i+1] = 4
	IF ObjectOrder[i] = 2 THEN
		GOSUB "Straight"
		IF Directions > ESP  THEN GOSUB "RightHotSpot"
		IF Directions < -ESP THEN GOSUB "LeftHotSpot"
		IF i < 2 GOSUB "StraightHotSpot"
		GOTO "NextIter"
	ENDIF

	IF ObjectOrder[i] = 3 THEN
		GOSUB "CurveLeft"
		GOSUB "LeftAngleHotSpot"
		GOSUB "StraightHotSpot"
		ObjectOrder[i+1] = 2 
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextIter"
	ENDIF

	IF ObjectOrder[i] = 4 THEN
		GOSUB "CurveRight"
		GOSUB "RightAngleHotSpot"
		GOSUB "StraightHotSpot"
		ObjectOrder[i+1] = 2 
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextIter"
	ENDIF
	"NextIter":
	i = i + 1
ENDWHILE
GOSUB "LastStraight"
END

"FirstStraight":
	HOTSPOT  0,  0,	0

	IF Directions < -ESP  THEN
		MULX -1
	ENDIF
	MATERIAL 18
	EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
		0,														0,						1,
		-LineWidth,												0,						1,
		-CurbeSegmentHeight - TransitionLineMargin - LineWidth,	TransitionLength,		1,
		-CurbeSegmentHeight - TransitionLineMargin,				TransitionLength,		1,
		0,														0,						1
	ADDY XMargin
	ROTY -90
	ROTX 11
	CUTPLANE 0
	DEL 2
	FOR j = 1 TO 3
		GOSUB "AlternatingColors"
		EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
			0,						0,						1,
			-CurbeSegmentHeight,	0,						1,
			-CurbeSegmentHeight,	CurbeSegmentWidth,		1,
			0,						CurbeSegmentWidth,		1,
			0,						0,						1
		IF NOT(j = 3) THEN ADDY CurbeSegmentWidth + CurbeSegmentMargin
	NEXT j
	CUTEND
	DEL 3
    IF Directions < -ESP  THEN DEL 1
    ADDY TransitionLength
RETURN

"LastStraight":
	IF Directions < -ESP  THEN
		MULX -1
	ENDIF
	MATERIAL 18
	EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
		-CurbeSegmentHeight - TransitionLineMargin - LineWidth,	0,					1,
		-CurbeSegmentHeight - TransitionLineMargin,				0,					1,
		0,														TransitionLength,	1,
		-LineWidth,												TransitionLength,	1,
		-CurbeSegmentHeight - TransitionLineMargin - LineWidth,	0,					1
	!ADDY XMargin
	ADDX -CurbeSegmentHeight
	ROTY -90
	ROTX -11
	CUTPLANE 0
	DEL 3
	FOR j = 1 TO 3
		GOSUB "AlternatingColors"
		EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
			0,						0,						1,
			-CurbeSegmentHeight,	0,						1,
			-CurbeSegmentHeight,	CurbeSegmentWidth,		1,
			0,						CurbeSegmentWidth,		1,
			0,						0,						1
		IF NOT(j = 3) THEN ADDY CurbeSegmentWidth + CurbeSegmentMargin
	NEXT j
	CUTEND
	DEL 3
    IF Directions < -ESP  THEN DEL 1
RETURN

!-----Makes The Straight-------------------------------------------------------------------------------------------------------------------------------------------------
"Straight":
	IF Directions < -ESP  THEN
		MULX -1
	ENDIF
	BREAKPOINT 1
	NumOfSegments = INT((NextLength[i-1]) / SegmentSizeWithMargin)
	MATERIAL 18
	EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
			-CurbeSegmentHeight - TransitionLineMargin,				0,										1,
			-CurbeSegmentHeight - TransitionLineMargin - LineWidth,	0,										1,
			-CurbeSegmentHeight - TransitionLineMargin - LineWidth,	NumOfSegments * SegmentSizeWithMargin,	1,
			-CurbeSegmentHeight - TransitionLineMargin,				NumOfSegments * SegmentSizeWithMargin,	1,
			-CurbeSegmentHeight - TransitionLineMargin,				0,										1
	FOR j = 1 TO NumOfSegments 
		GOSUB "AlternatingColors"
		EXTRUDE 5, 0, 0, Thickness, ExtrudeValues,
			0,						0,						1,
			-CurbeSegmentHeight,	0,						1,
			-CurbeSegmentHeight,	CurbeSegmentWidth,		1,
			0,						CurbeSegmentWidth,		1,
			0,						0,						1
		ADDY CurbeSegmentWidth + CurbeSegmentMargin
	NEXT j
	DEL NumOfSegments
    IF Directions < -ESP  THEN DEL 1

	ADDY NextLength[i-1]
RETURN
!----------------------------------------------------------------------------------------------------------------------------------------

!-----Makes The Right Curving Part-----------------------------------------------------------------------------------------------------------------------------------
"CurveRight":
    Angle = RightAngle[i]
    CurveRadius = CurveRight[i-1]
    SegmentAngle = CurbeSegmentWidth * 360 / (2 * PI * CurveRadius)

    IF CurveRadius > 0 THEN
        StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
        Angle = INT(RightAngle[i] / StepAngle) * StepAngle
        IF Angle < StepAngle THEN Angle = StepAngle
    ELSE
        Angle = RightAngle[i]
    ENDIF

    EndingX = CurveRadius - CurveRadius * COS(Angle)
    EndingY = CurveRadius * SIN(Angle)

    InnerRadius = CurveRadius + CurbeSegmentHeight + TransitionLineMargin
    OuterRadius = InnerRadius + LineWidth
    MATERIAL 18
    EXTRUDE 9, 0, 0, Thickness, 1+2+4+16+32,
        -CurbeSegmentHeight - TransitionLineMargin - LineWidth, 0,                          1,
        -CurbeSegmentHeight - TransitionLineMargin,             0,                          1,
        CurveRadius,                                            0,                          900,
        CurveRadius - InnerRadius * COS(Angle),                 InnerRadius * SIN(Angle),   3001,
        CurveRadius - InnerRadius * COS(Angle),                 InnerRadius * SIN(Angle),   1,
        CurveRadius - OuterRadius * COS(Angle),                 OuterRadius * SIN(Angle),   1,
        CurveRadius,                                            0,                          900,
        -CurbeSegmentHeight - TransitionLineMargin - LineWidth, 0,                          3001,
        -CurbeSegmentHeight - TransitionLineMargin - LineWidth, 0,                          1

	SegmentAngle = CurbeSegmentWidth * 360 / (2 * PI * CurveRadius)
    MarginAngle  = CurbeSegmentMargin * 360 / (2 * PI * CurveRadius)
    StepAngle    = SegmentAngle + MarginAngle

    IF StepAngle > 0 THEN
        nSegments = INT((Angle + MarginAngle) / StepAngle)
    ELSE
        nSegments = 0
    ENDIF

    SegmentEndingX = CurveRadius - CurveRadius * COS(SegmentAngle)
    SegmentEndingY = CurveRadius * SIN(SegmentAngle)
    OuterSegmentEndingX = CurveRadius - (CurveRadius + CurbeSegmentHeight) * COS(SegmentAngle)
    OuterSegmentEndingY = (CurveRadius + CurbeSegmentHeight) * SIN(SegmentAngle)

    FOR j = 1 TO nSegments
        GOSUB "AlternatingColors"
        EXTRUDE 9, 0, 0, Thickness, 1+2+4+16+32,
            -CurbeSegmentHeight,    0,                      1,
            0,                      0,                      1,
            CurveRadius,            0,                      900,
            SegmentEndingX,         SegmentEndingY,         3001,
            SegmentEndingX,         SegmentEndingY,         1,
            OuterSegmentEndingX,    OuterSegmentEndingY,    1,
            CurveRadius,            0,                      900,
            -CurbeSegmentHeight,    0,                      3001,
            -CurbeSegmentHeight,    0,                      1

        ADDX CurveRadius
        ROTZ -StepAngle
        ADDX -CurveRadius
    NEXT j
    IF nSegments > 0 THEN DEL 3 * nSegments
    ADDX EndingX
    ADDY EndingY
    ROTZ -Angle
RETURN

!-----Makes The Left Curving Part-----------------------------------------------------------------------------------------------------------------------------------
"CurveLeft":
    Angle = LeftAngle[i]
    CurveRadius = CurveLeft[i-1]
    SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin

    IF CurveRadius > 0 THEN
        StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
        Angle = INT(LeftAngle[i] / StepAngle) * StepAngle
        IF Angle < StepAngle THEN Angle = StepAngle
    ELSE
        Angle = LeftAngle[i]
    ENDIF

    ! Pure Track Geometric End Position (vektor obrnjen v -X)
    EndingX = -(CurveRadius - CurveRadius * COS(Angle))
    EndingY = CurveRadius * SIN(Angle)

    InnerRadius = CurveRadius + CurbeSegmentHeight + TransitionLineMargin
    OuterRadius = InnerRadius + LineWidth

    MATERIAL 18
    EXTRUDE 9, 0, 0, Thickness, 1+2+4+16+32,
        CurbeSegmentHeight + TransitionLineMargin + LineWidth,  0,                          1,
        CurbeSegmentHeight + TransitionLineMargin,              0,                          1,
        -CurveRadius,                                           0,                          900,
        -(CurveRadius - InnerRadius * COS(Angle)),              InnerRadius * SIN(Angle),   3001,
        -(CurveRadius - InnerRadius * COS(Angle)),              InnerRadius * SIN(Angle),   1,
        -(CurveRadius - OuterRadius * COS(Angle)),              OuterRadius * SIN(Angle),   1,
        -CurveRadius,                                           0,                          900,
        CurbeSegmentHeight + TransitionLineMargin + LineWidth,  0,                          3001,
        CurbeSegmentHeight + TransitionLineMargin + LineWidth,  0,                          1

    SegmentAngle = CurbeSegmentWidth * 360 / (2 * PI * CurveRadius)
    MarginAngle  = CurbeSegmentMargin * 360 / (2 * PI * CurveRadius)
    StepAngle    = SegmentAngle + MarginAngle

    IF StepAngle > 0 THEN
        nSegments = INT((Angle + MarginAngle) / StepAngle)
    ELSE
        nSegments = 0
    ENDIF

    SegmentEndingX = -(CurveRadius - CurveRadius * COS(SegmentAngle))
    SegmentEndingY = CurveRadius * SIN(SegmentAngle)
    OuterSegmentEndingX = -(CurveRadius - (CurveRadius + CurbeSegmentHeight) * COS(SegmentAngle))
    OuterSegmentEndingY = (CurveRadius + CurbeSegmentHeight) * SIN(SegmentAngle)

    FOR j = 1 TO nSegments
        GOSUB "AlternatingColors"
        EXTRUDE 9, 0, 0, Thickness, 1+2+4+16+32,
            CurbeSegmentHeight,     0,                      1,
            0,                      0,                      1,
            -CurveRadius,           0,                      900,
            SegmentEndingX,         SegmentEndingY,         3001,
            SegmentEndingX,         SegmentEndingY,         1,
            OuterSegmentEndingX,    OuterSegmentEndingY,    1,
            -CurveRadius,           0,                      900,
            CurbeSegmentHeight,     0,                      3001,
            CurbeSegmentHeight,     0,                      1

        ! Korak po loku v levo okoli centra (-CurveRadius, 0)
        ADDX -CurveRadius
        ROTZ StepAngle
        ADDX CurveRadius
    NEXT j

    IF nSegments > 0 THEN DEL 3 * nSegments

    ! Končni premik in rotacija na konec levega loka
    ADDX EndingX
    ADDY EndingY
    ROTZ Angle
RETURN
!----------------------------------------------------------------------------------------------------------------------------------------------
"AlternatingColors":
	AlternatingColorsBool = NOT(AlternatingColorsBool)
	IF AlternatingColorsBool THEN
		MATERIAL 19
	ELSE
		MATERIAL 18
	ENDIF
RETURN
!---Hot Spots-------------------------------------------------------------------------------------------------------------------------------------
"RightHotSpot":
	IF CurveLeft[i] < ESP THEN
		HOTSPOT 0.5,  0, 0, unID, CurveRight[i], 1 : unID = unID + 1
		HOTSPOT 0.5,  0, 0, unID, CurveRight[i], 2 : unID = unID + 1
		HOTSPOT 0.5, -1, 0, unID, CurveRight[i], 3 : unID = unID + 1
	ENDIF
RETURN

"RightAngleHotSpot":
	IF CurveRight[i] < ESP THEN 
		centerX = CurveRight[i-1]
		centerY = 0
		RightRadius = CurveRight[i-1]
		refX = centerX - RightRadius * COS(RightAngle[i])
		refY = centerY - RightRadius * SIN(RightAngle[i])

		HOTSPOT centerX,	centerY,	0, unID, RightAngle[i], 6	 		: unID = unID + 1
		HOTSPOT refX,		refY,		0, unID, RightAngle[i], 4 	: unID = unID + 1
		HOTSPOT 1,	 		0,			0, unID, RightAngle[i], 5   		: unID = unID + 1
	ENDIF
RETURN

"LeftHotSpot":
	IF CurveRight[i] < ESP THEN
		HOTSPOT -0.5,  0, 0, unID, CurveLeft[i], 1 : unID = unID + 1
		HOTSPOT -0.5,  0, 0, unID, CurveLeft[i], 2 : unID = unID + 1
		HOTSPOT -0.5, -1, 0, unID, CurveLeft[i], 3 : unID = unID + 1
	ENDIF
RETURN

"LeftAngleHotSpot":
	IF CurveLeft[i] < ESP THEN 
		centerX = -CurveLeft[i-1]
		centerY = 0
		LeftRadius = CurveLeft[i-1] - 1 
		IF LeftAngle[i] >= 180 THEN LeftAngle[i] = LeftAngle[i] - 1
		refX = centerX + LeftRadius * COS(-LeftAngle[i])
		refY = centerY + LeftRadius * SIN(-LeftAngle[i])
		HOTSPOT centerX,	centerY,	0, unID,	LeftAngle[i], 6 		: unID = unID + 1
		HOTSPOT refX,   	refY,		0, unID,	LeftAngle[i], 4 + 128	: unID = unID + 1
		HOTSPOT -1,			0,			0, unID,	LeftAngle[i], 5 		: unID = unID + 1
	ENDIF
RETURN

"StraightHotSpot":
	IF NextLength[i] < -ESP THEN NextLength[i] = ESP
	HOTSPOT 0,  0,				0, unID, NextLength[i], 1 : unID = unID + 1
	HOTSPOT 0,  NextLength[i], 	0, unID, NextLength[i], 2 : unID = unID + 1
	HOTSPOT 0, -1,				0, unID, NextLength[i], 3 : unID = unID + 1
RETURN

"DirectionsHotSpot":
	IF NOT(CurveLeft[2] > ESP OR CurveRight[2] > ESP) THEN 
		HOTSPOT  0,  -1,	0, unID, Directions, 1 : unID = unID + 1
		HOTSPOT  0,  -1, 	0, unID, Directions, 2 : unID = unID + 1
		HOTSPOT -1,  -1,	0, unID, Directions, 3 : unID = unID + 1
	ENDIF
RETURN

!----------------------------------------------------------------------------------------------------------------------------------------
]]>
