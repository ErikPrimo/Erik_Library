<Script_1D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
unID = 1
ESP = 0.000001
ExtrudeValues = 1+2+4+16+32

CircleSize = 0.11
TrackColor = 22
CircleColor = 11

TempWidth = 7

TopTubeLightHeight = 0.85

PoleWidth = 0.042

RightLightRemainingDistance = 0
TotalLength_Calc = 0


CurbeSegmentWidth = 0.5
CurbeSegmentHeight = 0.3
CurbeSegmentMargin = 0.02
LineMargin = 0.05
LineWidth = 0.1
XMargin = 0.3
TransitionLength = 1.8391
TransitionLineMargin = 0.0509
TransitionOrientation = 1
SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin
AlternatingColorsBool = 1


FOR i = 1 TO 120
	!----Sets Every Angle To Default 90 Degrees And Offsets So Its Easier To Set Angle----------------------------------------------------
	IF RightAngle[i] < ESP THEN RightAngle[i] = 90
	IF LeftAngle[i] < ESP THEN LeftAngle[i] = 90
	!-------------------------------------------------------------------------------------------------------------------------------------

	!-----Sets Limit On Angle-------------------------------------------------------------------------------------------------------------
	RightAngle[i] = MIN(180, MAX(0, RightAngle[i]))
	LeftAngle[i]  = MIN(180, MAX(0, LeftAngle[i]))
	!-------------------------------------------------------------------------------------------------------------------------------------
	IF NOT(NextLength[i] = 0) THEN NextLength[i] = INT(NextLength[i] / SegmentSizeWithMargin) * SegmentSizeWithMargin
	!IF i = 1 AND NextLength[i] < TransitionLength THEN NextLength[i] = TransitionLength
	!IF i = 1 AND NextLength[i] > TransitionLength THEN NextLength[i] = NextLength[i] - 0.2 - CurbeSegmentMargin*2
NEXT i


!------Calculate Length----------------------------------------------------------------------------------------------------------------------
TotalLength_Calc = 0

! --- 1. First Straight Evaluation ---
IF NextLength[1] = 0 AND CurveLeft[1] = 0 AND CurveRight[1] = 0 THEN
	TotalLength_Calc = TotalLength_Calc + BeginningDistance
ENDIF

! --- 2. Iterate Segments to Calculate Total Length ---
i = 1
WHILE ObjectOrder[i] <> 0 DO
	IF NextLength[i] > ESP        THEN ObjectOrder[i+1] = 2
	IF CurveLeft[i]  > ESP        THEN ObjectOrder[i+1] = 3
	IF CurveRight[i] > ESP        THEN ObjectOrder[i+1] = 4

	IF ObjectOrder[i] = 2 THEN
		TotalLength_Calc = TotalLength_Calc + NextLength[i-1]
		GOTO "NextMasterIter"
	ENDIF

	IF ObjectOrder[i] = 3 THEN
		
		TotalLength_Calc = TotalLength_Calc + (CurveLeft[i-1] * (LeftAngle[i] * PI / 180))

		ObjectOrder[i+1] = 2
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextMasterIter"
	ENDIF

	IF ObjectOrder[i] = 4 THEN
		TotalLength_Calc = TotalLength_Calc + (CurveRight[i-1] * (RightAngle[i] * PI / 180))
		
		ObjectOrder[i+1] = 2
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextMasterIter"
	ENDIF

	"NextMasterIter":
	i = i + 1
ENDWHILE

NumberOfPosts = INT(TotalLength_Calc / 1.5 + 0.9999)
]]>
</Script_1D>

