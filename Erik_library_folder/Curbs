<Script_1D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
unID = 1
ESP = 0.000001
IF GLOB_FEEDBACK_MODE THEN
	ExtrudeValues = 1+2+4+16+32
ELSE
	ExtrudeValues = 1+2+4
ENDIF

ColorCircles = 1
LibraryBool = LIBRARYGLOBAL ("Erik_MVO", "ColorCircles", ColorCircles)

CircleSize = 0.11
TrackColor = 22
CircleColor = 11

TempWidth = 7

TopTubeLightHeight = 0.85

PoleWidth = 0.042

RightLightRemainingDistance = 0

CurbeSegmentWidth = 0.5
CurbeSegmentHeight = 0.3
CurbeSegmentMargin = 0.02
LineMargin = 0.05
LineWidth = 0.1
XMargin = 0.3
TransitionLength = 1.8391
TransitionLineMargin = 0.0509
TransitionOrientation = 1
SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin
AlternatingColorsBool = 1


FOR i = 1 TO 120
	!----Sets Every Angle To Default 90 Degrees And Offsets So Its Easier To Set Angle----------------------------------------------------
	IF RightAngle[i] < ESP THEN RightAngle[i] = 90
	IF LeftAngle[i] < ESP THEN LeftAngle[i] = 90
	!-------------------------------------------------------------------------------------------------------------------------------------

	!-----Sets Limit On Angle-------------------------------------------------------------------------------------------------------------
	RightAngle[i] = MIN(180, MAX(0, RightAngle[i]))
	LeftAngle[i]  = MIN(180, MAX(0, LeftAngle[i]))
	!-------------------------------------------------------------------------------------------------------------------------------------
	IF NOT(NextLength[i] = 0) THEN NextLength[i] = INT(NextLength[i] / SegmentSizeWithMargin) * SegmentSizeWithMargin
NEXT i


! Geometric constants
CurbUnitArea = CurbeSegmentHeight * CurbeSegmentWidth  ! Rectangular area per block
! Local color alternation tracker matching 3D loop state
calcAlternatingBool = 0
TotalArea_Line        = 0.0
TotalArea_Curbs_White = 0.0
TotalArea_Curbs_Color = 0.0
TotalCurbCount        = 0
! -------------------------------------------------------------------------
! 1. FIRST STRAIGHT (TRANSITION)
! -------------------------------------------------------------------------
! Line element is a trapezoid: base1 = LineWidth, base2 = LineWidth, length = TransitionLength
LineArea_First = LineWidth * TransitionLength
TotalArea_Line = TotalArea_Line + LineArea_First
! 3 transition curb blocks
TotalArea_Curbs_White = TotalArea_Curbs_White + CurbUnitArea/2
TotalArea_Curbs_Color = TotalArea_Curbs_Color + CurbUnitArea
TotalCurbCount = TotalCurbCount + 3
! -------------------------------------------------------------------------
! 2. MAIN SEGMENT LOOP
! -------------------------------------------------------------------------
BREAKPOINT 1
IF NextLength[1] = 0 AND CurveLeft[1] = 0 AND CurveRight[1] = 0 THEN
	NextLength[1] = CurbeSegmentMargin
ENDIF
k = 1
WHILE ObjectOrder[k] <> 0 DO
	IF NextLength[k] > ESP 		 THEN ObjectOrder[k+1] = 2
	IF CurveLeft[k]  > ESP 		 THEN ObjectOrder[k+1] = 3
	IF CurveRight[k] > ESP 		 THEN ObjectOrder[k+1] = 4
	! --- STRAIGHT SEGMENT ---
	IF ObjectOrder[k] = 2 THEN
		NumOfSegments   = INT(NextLength[k-1] / SegmentSizeWithMargin)
		! Line area along the snapped curb span
		lineSpan = NumOfSegments * SegmentSizeWithMargin
		TotalArea_Line = TotalArea_Line + (LineWidth * lineSpan)
		BREAKPOINT 1
		! Curb blocks
		FOR j = 1 TO NumOfSegments
			calcAlternatingBool = NOT(calcAlternatingBool)
			IF calcAlternatingBool THEN
				TotalArea_Curbs_White = TotalArea_Curbs_White + CurbUnitArea
			ELSE
				TotalArea_Curbs_Color = TotalArea_Curbs_Color + CurbUnitArea
			ENDIF
			TotalCurbCount = TotalCurbCount + 1
		NEXT j
	ENDIF
	! --- LEFT CURVE SEGMENT ---
	IF ObjectOrder[k] = 3 THEN
		CurveRadius = CurveLeft[k-1]
		IF CurveRadius > 0 THEN
			StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
			Angle     = INT(LeftAngle[k] / StepAngle) * StepAngle
			IF Angle < StepAngle THEN Angle = StepAngle
			! Line area: Circular ring sector
			InnerRadius = CurveRadius + CurbeSegmentHeight + TransitionLineMargin
			OuterRadius = InnerRadius + LineWidth
			angleRad    = Angle * PI / 180
			TotalArea_Line = TotalArea_Line + (0.5 * angleRad * (OuterRadius^2 - InnerRadius^2))
			! Curved curb blocks
			SegmentAngle = CurbeSegmentWidth * 360 / (2 * PI * CurveRadius)
			MarginAngle  = CurbeSegmentMargin * 360 / (2 * PI * CurveRadius)
			StepAngLocal = SegmentAngle + MarginAngle
			IF StepAngLocal > 0 THEN
				nSegments = INT((Angle + MarginAngle) / StepAngLocal)
			ELSE
				nSegments = 0
			ENDIF
			segAngleRad  = SegmentAngle * PI / 180
			R_curb_inner = CurveRadius
			R_curb_outer = CurveRadius + CurbeSegmentHeight
			curvedCurbArea = 0.5 * segAngleRad * (R_curb_outer^2 - R_curb_inner^2)
			FOR j = 1 TO nSegments
				calcAlternatingBool = NOT(calcAlternatingBool)
				IF calcAlternatingBool THEN
					TotalArea_Curbs_White = TotalArea_Curbs_White + curvedCurbArea
				ELSE
					TotalArea_Curbs_Color = TotalArea_Curbs_Color + curvedCurbArea
				ENDIF
				TotalCurbCount = TotalCurbCount + 1
			NEXT j
		ENDIF
	ENDIF
	! --- RIGHT CURVE SEGMENT ---
	IF ObjectOrder[k] = 4 THEN
		CurveRadius = CurveRight[k-1]
		IF CurveRadius > 0 THEN
			StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
			Angle     = INT(RightAngle[k] / StepAngle) * StepAngle
			IF Angle < StepAngle THEN Angle = StepAngle
			! Line area: Circular ring sector between InnerRadius and OuterRadius
			! Area = (Angle in radians / 2) * (R_outer^2 - R_inner^2)
			InnerRadius = CurveRadius + CurbeSegmentHeight + TransitionLineMargin
			OuterRadius = InnerRadius + LineWidth
			angleRad    = Angle * PI / 180
			TotalArea_Line = TotalArea_Line + (0.5 * angleRad * (OuterRadius^2 - InnerRadius^2))
			! Curved curb blocks
			SegmentAngle = CurbeSegmentWidth * 360 / (2 * PI * CurveRadius)
			MarginAngle  = CurbeSegmentMargin * 360 / (2 * PI * CurveRadius)
			StepAngLocal = SegmentAngle + MarginAngle
			IF StepAngLocal > 0 THEN
				nSegments = INT((Angle + MarginAngle) / StepAngLocal)
			ELSE
				nSegments = 0
			ENDIF
			! Circular ring sector area per single curved curb block
			segAngleRad  = SegmentAngle * PI / 180
			R_curb_inner = CurveRadius
			R_curb_outer = CurveRadius + CurbeSegmentHeight
			curvedCurbArea = 0.5 * segAngleRad * (R_curb_outer^2 - R_curb_inner^2)
			FOR j = 1 TO nSegments
				calcAlternatingBool = NOT(calcAlternatingBool)
				IF calcAlternatingBool THEN
					TotalArea_Curbs_White = TotalArea_Curbs_White + curvedCurbArea
				ELSE
					TotalArea_Curbs_Color = TotalArea_Curbs_Color + curvedCurbArea
				ENDIF
				TotalCurbCount = TotalCurbCount + 1
			NEXT j
		ENDIF
	ENDIF
	k = k + 1
ENDWHILE
! -------------------------------------------------------------------------
! 3. LAST STRAIGHT (TRANSITION)
! -------------------------------------------------------------------------
LineArea_Last  = LineWidth * TransitionLength
TotalArea_Line = TotalArea_Line + LineArea_Last
calcAlternatingBool = NOT(calcAlternatingBool)
BREAKPOINT 1
IF calcAlternatingBool THEN
	TotalArea_Curbs_Color = TotalArea_Curbs_Color + CurbUnitArea/2
	TotalArea_Curbs_White = TotalArea_Curbs_White + CurbUnitArea
ELSE
	TotalArea_Curbs_White = TotalArea_Curbs_White + CurbUnitArea/2
	TotalArea_Curbs_Color = TotalArea_Curbs_Color + CurbUnitArea
ENDIF
TotalCurbCount = TotalCurbCount + 3
! -------------------------------------------------------------------------
! 4. COMBINED TOTALS
! -------------------------------------------------------------------------
TotalArea_Curbs = TotalArea_Curbs_White + TotalArea_Curbs_Color
TotalArea_All   = TotalArea_Line + TotalArea_Curbs
]]>
</Script_1D>

