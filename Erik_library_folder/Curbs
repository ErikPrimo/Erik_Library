<Script_2D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
SET FILL "Solid Fill"
PEN 1

! 3D projekcija modela v tloris
PROJECT2{3} 3, 270, 3 + 16, 4 + 8


! Globalni zasuk objekta in luči
ROT2 ObjectAngle
GOSUB "ObjectAngleHotSpot"
GOSUB "DirectionsHotSpot2D"

HOTSPOT2  0,  0
GOSUB "FirstStraightOrientationHotSpot"
ADD2 0, TransitionLength

i = 1
GOSUB "StraightHotSpot2D"
IF NextLength[1] = 0 AND CurveLeft[1] = 0 AND CurveRight[1] = 0 THEN
	NextLength[1] = CurbeSegmentMargin
ENDIF

! Glavna zanka po segmentih
WHILE ObjectOrder[i] <> 0 DO
    IF NextLength[i] > ESP THEN ObjectOrder[i+1] = 2
    IF CurveLeft[i]  > ESP THEN ObjectOrder[i+1] = 3
    IF CurveRight[i] > ESP THEN ObjectOrder[i+1] = 4

    IF ObjectOrder[i] = 2 THEN
        GOSUB "Straight2D"
        IF Directions > ESP  THEN GOSUB "RightHotSpot2D"
        IF Directions < -ESP THEN GOSUB "LeftHotSpot2D"
        IF i < 2 THEN GOSUB "StraightHotSpot2D"
        GOTO "NextIter2D"
    ENDIF
	
	IF ObjectOrder[i] = 3 THEN
        GOSUB "CurveLeft2D"
        GOSUB "LeftAngleHotSpot2D"
        GOSUB "StraightHotSpot2D"
        ObjectOrder[i+1] = 2 
        IF NextLength[i] <= 0 THEN NextLength[i] = ESP
        GOTO "NextIter2D"
    ENDIF

    IF ObjectOrder[i] = 4 THEN
        GOSUB "CurveRight2D"
        GOSUB "RightAngleHotSpot2D"
        GOSUB "StraightHotSpot2D"
        ObjectOrder[i+1] = 2 
        IF NextLength[i] <= 0 THEN NextLength[i] = ESP
        GOTO "NextIter2D"
    ENDIF

    "NextIter2D":
    i = i + 1
ENDWHILE
GOSUB "LastStraightOrientationHotSpot2D"
! Zaključni prehod (LastStraight)
IF Directions < -ESP THEN MUL2 -1, 1
ADD2 0, TransitionLength
IF Directions < -ESP THEN DEL 1

END

!=================================================================================================================================================
! 2D GEOMETRIJSKI PREMIKI
!=================================================================================================================================================

"Straight2D":
    ADD2 0, NextLength[i-1]
RETURN

"CurveRight2D":
    CurveRadius = CurveRight[i-1]
    SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin

    IF CurveRadius > 0 THEN
        StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
        Angle = INT(RightAngle[i] / StepAngle) * StepAngle
        IF Angle < StepAngle THEN Angle = StepAngle
    ELSE
        Angle = RightAngle[i]
    ENDIF

    EndingX = CurveRadius - CurveRadius * COS(Angle)
    EndingY = CurveRadius * SIN(Angle)

    ADD2 EndingX, EndingY
    ROT2 -Angle
RETURN

"CurveLeft2D":
    CurveRadius = CurveLeft[i-1]
    SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin

    IF CurveRadius > 0 THEN
        StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRadius)
        Angle = INT(LeftAngle[i] / StepAngle) * StepAngle
        IF Angle < StepAngle THEN Angle = StepAngle
    ELSE
        Angle = LeftAngle[i]
    ENDIF

    EndingX = -(CurveRadius - CurveRadius * COS(Angle))
    EndingY = CurveRadius * SIN(Angle)

    ADD2 EndingX, EndingY
    ROT2 Angle
RETURN

!=================================================================================================================================================
! 2D HOTSPOTS IN KROGI
!=================================================================================================================================================


"RightHotSpot2D":
    IF CurveLeft[i] < ESP THEN
        HOTSPOT2 0.5,  0, unID, CurveRight[i], 1 : unID = unID + 1
        HOTSPOT2 0.5,  0, unID, CurveRight[i], 2 : unID = unID + 1
        HOTSPOT2 0.5, -1, unID, CurveRight[i], 3 : unID = unID + 1
        IF ColorCircles THEN
            POLY2_B 2, 1+2+4,
                8, 0,
                0.5, 0, 900,
                CircleSize, 360, 4001
        ENDIF
    ENDIF
RETURN

"RightAngleHotSpot2D":
    IF CurveRight[i] < ESP THEN 
		centerX = CurveRight[i-1]
		centerY = 0
		RightRadius = CurveRight[i-1]-1
		refX = centerX - RightRadius * COS(RightAngle[i])
		refY = centerY - RightRadius * SIN(RightAngle[i])
		HOTSPOT2 centerX,	centerY, unID, RightAngle[i], 6 + 512	: unID = unID + 1
		HOTSPOT2 refX,		refY,	 unID, RightAngle[i], 4 + 128 	: unID = unID + 1
		HOTSPOT2 1,	 		0,		 unID, RightAngle[i], 5   		: unID = unID + 1

        IF ColorCircles THEN
            POLY2_B 2, 1+2+4,
                6, 0,
                1, 0, 900,
                CircleSize, 360, 4001
        ENDIF
    ENDIF
RETURN

"LeftHotSpot2D":
    IF CurveRight[i] < ESP THEN
        HOTSPOT2 -0.5,  0, unID, CurveLeft[i], 1 : unID = unID + 1
        HOTSPOT2 -0.5,  0, unID, CurveLeft[i], 2 : unID = unID + 1
        HOTSPOT2 -0.5, -1, unID, CurveLeft[i], 3 : unID = unID + 1
        IF ColorCircles THEN
            POLY2_B 2, 1+2+4,
                5, 0,
                -0.5, 0, 900,
                CircleSize, 360, 4001
        ENDIF
    ENDIF
RETURN

"LeftAngleHotSpot2D":
    IF CurveLeft[i] < ESP THEN 
		centerX = -CurveLeft[i-1]
		centerY = 0
		LeftRadius = CurveLeft[i-1] - 1 
		IF LeftAngle[i] >= 180 THEN LeftAngle[i] = LeftAngle[i] - 1
		refX = centerX + LeftRadius * COS(-LeftAngle[i])
		refY = centerY + LeftRadius * SIN(-LeftAngle[i])
		HOTSPOT2 centerX,	centerY,	 unID,	LeftAngle[i], 6 	: unID = unID + 1
		HOTSPOT2 refX,   	refY,		 unID,	LeftAngle[i], 4 + 128	: unID = unID + 1
		HOTSPOT2 -1,			0,		 unID,	LeftAngle[i], 5 		: unID = unID + 1
        IF ColorCircles THEN
            POLY2_B 2, 1+2+4,
                6, 0,
                -1, 0, 900,
                CircleSize, 360, 4001
        ENDIF
    ENDIF
RETURN

"StraightHotSpot2D":
BREAKPOINT 1
    IF NextLength[i] < -ESP THEN NextLength[i] = ESP
    HOTSPOT2 0,  0,             unID, NextLength[i], 1 + 128	: unID = unID + 1
    HOTSPOT2 0,  NextLength[i], unID, NextLength[i], 2 			: unID = unID + 1
    HOTSPOT2 0, -1,             unID, NextLength[i], 3 			: unID = unID + 1

    IF GLOB_CONTEXT = 22 THEN
        LINE2  0,   0,                  0, NextLength[i]
        LINE2 -0.3, NextLength[i] - 0.3, 0, NextLength[i]
        LINE2  0.3, NextLength[i] - 0.3, 0, NextLength[i]
    ENDIF

    IF ColorCircles THEN
        POLY2_B 2, 1+2+4,
            4, 0,
            0, NextLength[i], 900,
            CircleSize, 360, 4001
    ENDIF
RETURN

"ObjectAngleHotSpot":
    HOTSPOT2 0,    0, unID, ObjectAngle, 6         : unID = unID + 1
    HOTSPOT2 -0.5, 0, unID, ObjectAngle, 4 + 128   : unID = unID + 1
    HOTSPOT2 -1,   0, unID, ObjectAngle, 5         : unID = unID + 1
    IF ColorCircles THEN
        POLY2_B 2, 1+2+4,
            19, 0,
            -1, 0, 900,
            CircleSize, 360, 4001
    ENDIF
RETURN

"DirectionsHotSpot2D":
	IF NOT(CurveLeft[2] > ESP OR CurveRight[2] > ESP) THEN 
		HOTSPOT2  0,  -1, unID, Directions, 1 : unID = unID + 1
		HOTSPOT2  0,  -1, unID, Directions, 2 : unID = unID + 1
