<![CDATA[
DIM vlist[]
n = 1
FOR i = 1 TO 100
	IF NextLength[i] > ESP THEN 
    	vlist[n] = i
		n = n + 1
	ENDIF
NEXT i

LOCK "TotalTrackLength"
PARAMETERS TotalTrackLength = TotalLength_Calc

LOCK "NumberOfPosts"
PARAMETERS NumberOfPosts = NumberOfPosts

VALUES "LightAngle" 45, 90, 135, 225, 270, 315

SegmentSizeWithMargin = CurbeSegmentWidth + CurbeSegmentMargin

! --- Zaskok kota na polne segmente ---
FOR i = 1 TO VARDIM1(RightAngle)
    IF CurveRight[i] > 0 THEN
        StepAngle = SegmentSizeWithMargin * 360 / (2 * PI * CurveRight[i])
        IF RightAngle[i] > 0 AND StepAngle > 0 THEN
            newAngle = INT(RightAngle[i] / StepAngle) * StepAngle
            IF newAngle < StepAngle THEN newAngle = StepAngle
            RightAngle[i] = newAngle
        ENDIF
    ENDIF
NEXT i
PARAMETERS RightAngle = RightAngle

! --- ALI zaskok polmera na polne segmente (če prilagajaš polmer) ---
FOR i = 1 TO VARDIM1(CurveRight)
    IF CurveRight[i] > 0 AND RightAngle[i] > 0 THEN
        ArcLen = (2 * PI * CurveRight[i]) * (RightAngle[i] / 360)
        nSeg = INT(ArcLen / SegmentSizeWithMargin)
        IF nSeg < 1 THEN nSeg = 1
        
        CurveRight[i] = (nSeg * SegmentSizeWithMargin * 360) / (2 * PI * RightAngle[i])
    ENDIF
NEXT i
PARAMETERS CurveRight = CurveRight
]]>
</Script_VL>

