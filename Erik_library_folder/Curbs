	HOTSPOT2  Offset,				0, 		unID, FirstStraightOrientation, 2 : unID = unID + 1
	HOTSPOT2  Offset+Direction,		0,		unID, FirstStraightOrientation, 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			31, 0,
			Offset, 0, 900,
