<![CDATA[
MATERIAL Asfalt
RESOL 64
BREAKPOINT 1
!----Light Angle----------------------------------------------------------------------------------------------------------------------------------------------
GOSUB "LightAngleHotSpot"
!-----------------------------------------------------------------------------------------------------------------------------------------------------------------

!-------Main Loop Places All Objects------------------------------------------------------------------------------------------------------------------------------
i = 1
GOSUB "StraightHotSpot"
IF NextLength[1] = 0 AND CurveLeft[1] = 0 AND CurveRight[1] = 0 THEN
	GOSUB "RightHotSpot"
	GOSUB "LeftHotSpot"
ENDIF
WHILE ObjectOrder[i] <> 0 DO
	IF NextLength[i] > ESP 		 THEN ObjectOrder[i+1] = 2
	IF CurveLeft[i]  > ESP 		 THEN ObjectOrder[i+1] = 3
	IF CurveRight[i] > ESP 		 THEN ObjectOrder[i+1] = 4
	IF ObjectOrder[i] = 2 THEN
		GOSUB "Straight"
		GOSUB "RightHotSpot"
		GOSUB "LeftHotSpot"
		IF i < 2 GOSUB "StraightHotSpot"
		GOTO "NextIter"
	ENDIF

	IF ObjectOrder[i] = 3 THEN
		GOSUB "CurveLeft"
		GOSUB "LeftAngleHotSpot"
		GOSUB "StraightHotSpot"
		ObjectOrder[i+1] = 2 
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextIter"
	ENDIF

	IF ObjectOrder[i] = 4 THEN
		GOSUB "CurveRight"
		GOSUB "RightAngleHotSpot"
		GOSUB "StraightHotSpot"
		ObjectOrder[i+1] = 2 
		IF NextLength[i] <= 0 THEN NextLength[i] = ESP
		GOTO "NextIter"
	ENDIF
	"NextIter":
	i = i + 1
ENDWHILE

END
!-----Makes The Straight-------------------------------------------------------------------------------------------------------------------------------------------------
"Straight":
	!------TopTube----------------------------------------------------------------------------------------------------------------------------------
	TubeFi = 0.080
	PoleHeigth = 1.148-TubeFi/2
	ADDZ PoleHeigth - TubeFi/4
	PUT 0, -1, 					0, 0,
		0,  0, 					0, 0,
		0,  NextLength[i-1], 	0, 0,
		0,  NextLength[i-1]+1, 	0, 0
	GOSUB "LightTube"
	DEL 1
	!----------------------------------------------------------------------------------------------------------------------------------------

	! --- Right Edge Lights --------------------------------------------------------------------------------------------------
	IF RightLightRemainingDistance <= NextLength[i-1] THEN
		NumLightsRight = INT((NextLength[i-1] - RightLightRemainingDistance) / LightDistance)
		FOR j = 0 TO NumLightsRight
			CurrentPosRight = RightLightRemainingDistance + (LightDistance * j)
			IF CurrentPosRight <= NextLength[i-1] THEN
				ADDY CurrentPosRight
				ADDX -PoleWidth/2
				IF TopTubeVisible THEN CALL "GF_TopTube"
				DEL 1
				ROTZ -LightAngle
				IF RightLightBool AND LightVisible AND NOT(TopTubeVisible) THEN 
					CALL "GF_Light" PARAMETERS LightStrength = LightStrength
				ENDIF
				IF RightLightBool AND LightVisible AND TopTubeVisible THEN 
					ADDZ TopTubeLightHeight
					CALL "FenceLight" PARAMETERS LightStrength = LightStrength
					DEL 1
				ENDIF
				RightLightBool = NOT(RightLightBool)
				DEL 2
			ENDIF
			LastLightPosRight = CurrentPosRight
		NEXT j
		RightLightRemainingDistance = LightDistance - (NextLength[i-1] - LastLightPosRight)
	ELSE
		RightLightRemainingDistance = RightLightRemainingDistance - NextLength[i-1]
	ENDIF
	ADDY NextLength[i-1]
RETURN
!----------------------------------------------------------------------------------------------------------------------------------------

!-----Makes The Right Curving Part-----------------------------------------------------------------------------------------------------------------------------------
"CurveRight":
    Angle = RightAngle[i]
    CurveRadius = CurveRight[i-1]
	GOSUB "RightTopTube"
	GOSUB "RightCurveLights"
	ADDX EndingX
	ADDY EndingY
	ROTZ -Angle
RETURN

"RightTopTube":
    TubeFi = 0.080
    PoleHeigth = 1.148 - TubeFi/2
    ADDZ PoleHeigth - TubeFi/4
    PUT 0, -1, 0, 0
    PUT 0,  0, 0, 0

    EndingX = 0
    EndingY = 0

    FOR n = 0 TO SegmentsResolution
        AngleSegment = (n / SegmentsResolution) * RightAngle[i]
        EndingX = CurveRadius - CurveRadius * COS(AngleSegment)
        EndingY = CurveRadius * SIN(AngleSegment)
        PUT EndingX, EndingY, 0, 0
    NEXT n

    _xEndIn = CurveRadius - CurveRadius * COS(RightAngle[i]) + SIN(RightAngle[i])
    _yEndIn = CurveRadius * SIN(RightAngle[i]) + COS(RightAngle[i])
    PUT _xEndIn, _yEndIn, 0, 0

    GOSUB "LightTube"
    DEL 1
RETURN

"RightCurveLights":
    CurveRadius = CurveRadius

    ! Center of curvature pivot
    ADDX CurveRadius

    InnerCurveArcLength = CurveRadius * (Angle * PI / 180)
    InnerAngleStep = (LightDistance / CurveRadius) * (180 / PI)

    InnerStartAngleOffset = (RightLightRemainingDistance / CurveRadius) * (180 / PI)
    RemainingCurveLengthIn = InnerCurveArcLength - RightLightRemainingDistance

    IF RemainingCurveLengthIn >= 0 THEN
        InnerTotalSteps = INT(RemainingCurveLengthIn / LightDistance)
        FOR k = 0 TO InnerTotalSteps
            CurrentAngle = InnerStartAngleOffset + (InnerAngleStep * k)
            IF CurrentAngle <= Angle THEN
                ROTZ -CurrentAngle
                ADDX -CurveRadius - PoleWidth/2
                IF TopTubeVisible THEN CALL "GF_TopTube"
                ROTZ -LightAngle
                IF RightLightBool AND LightVisible AND NOT(TopTubeVisible) THEN 
                    CALL "GF_Light" PARAMETERS LightStrength = LightStrength
                ENDIF

                IF RightLightBool AND LightVisible AND TopTubeVisible THEN 
                    ADDZ TopTubeLightHeight
                    CALL "FenceLight" PARAMETERS LightStrength = LightStrength
                    DEL 1
                ENDIF

                RightLightBool = NOT(RightLightBool)
                DEL 3
            ENDIF
        NEXT k

        LastArcAngleUsedIn = InnerStartAngleOffset + (InnerAngleStep * InnerTotalSteps)
        ArcDistanceUsedIn = LastArcAngleUsedIn * (PI / 180) * CurveRadius
        FinalLeftoverLinearIn = InnerCurveArcLength - ArcDistanceUsedIn

        RightLightRemainingDistance = LightDistance - FinalLeftoverLinearIn
    ELSE
        RightLightRemainingDistance = RightLightRemainingDistance - InnerCurveArcLength
    ENDIF

    DEL 1 ! Clears ADDX CurveRadius
RETURN

!-----Makes The Left Curving Part-----------------------------------------------------------------------------------------------------------------------------------
"CurveLeft":
    Angle = LeftAngle[i]
    CurveRadius = CurveLeft[i-1]

	GOSUB "LeftTopTube"
	GOSUB "LeftCurveLights"

	ADDX -EndingX
	ADDY EndingY
	ROTZ Angle

RETURN

"LeftTopTube":
    TubeFi = 0.080
    PoleHeigth = 1.148 - TubeFi/2
    ADDZ PoleHeigth - TubeFi/4

    PUT 0, -1, 0, 0
    PUT 0,  0, 0, 0

    EndingX = 0
    EndingY = 0

    FOR n = 0 TO SegmentsResolution
        AngleSegment = (n / SegmentsResolution) * LeftAngle[i]
        EndingX = CurveLeft[i-1] - CurveLeft[i-1] * COS(AngleSegment)
        EndingY = CurveLeft[i-1] * SIN(AngleSegment)
        PUT -EndingX, EndingY, 0, 0
    NEXT n

    _xEndIn = -(CurveLeft[i-1] - CurveLeft[i-1] * COS(LeftAngle[i]) + SIN(LeftAngle[i]))
    _yEndIn = CurveLeft[i-1] * SIN(LeftAngle[i]) + COS(LeftAngle[i])
    PUT _xEndIn, _yEndIn, 0, 0

    GOSUB "LightTube"
    DEL 1
RETURN

"LeftCurveLights":
    ADDX -CurveRadius

    InnerCurveArcLength = CurveRadius * (Angle * PI / 180)
    InnerAngleStep = (LightDistance / CurveRadius) * (180 / PI)

    InnerStartAngleOffset = (RightLightRemainingDistance / CurveRadius) * (180 / PI)
    RemainingCurveLengthIn = InnerCurveArcLength - RightLightRemainingDistance

    IF RemainingCurveLengthIn >= 0 THEN
        InnerTotalSteps = INT(RemainingCurveLengthIn / LightDistance)
        FOR k = 0 TO InnerTotalSteps
            CurrentAngle = InnerStartAngleOffset + (InnerAngleStep * k)
            IF CurrentAngle <= Angle THEN
                ROTZ CurrentAngle
                ADDX CurveRadius - PoleWidth/2
                IF TopTubeVisible THEN CALL "GF_TopTube"
                ROTZ -LightAngle
                IF RightLightBool AND LightVisible AND NOT(TopTubeVisible) THEN 
                    CALL "GF_Light" PARAMETERS LightStrength = LightStrength
                ENDIF

                IF RightLightBool AND LightVisible AND TopTubeVisible THEN 
                    ADDZ TopTubeLightHeight
                    CALL "FenceLight" PARAMETERS LightStrength = LightStrength
                    DEL 1
                ENDIF

                RightLightBool = NOT(RightLightBool)
                DEL 3
            ENDIF
        NEXT k

        LastArcAngleUsedIn = InnerStartAngleOffset + (InnerAngleStep * InnerTotalSteps)
        ArcDistanceUsedIn = LastArcAngleUsedIn * (PI / 180) * CurveRadius
        FinalLeftoverLinearIn = InnerCurveArcLength - ArcDistanceUsedIn

        RightLightRemainingDistance = LightDistance - FinalLeftoverLinearIn
    ELSE
        RightLightRemainingDistance = RightLightRemainingDistance - InnerCurveArcLength
    ENDIF

    DEL 1
RETURN

!---Hot Spots-------------------------------------------------------------------------------------------------------------------------------------
"LightAngleHotSpot":
	IF LightVisible THEN
		HOTSPOT 2,	 0,	0, unID, LightAngle, 518		: unID = unID + 1
		HOTSPOT 2,	-1,	0, unID, LightAngle, 4 + 128	: unID = unID + 1
		HOTSPOT 1,	 0,	0, unID, LightAngle, 5			: unID = unID + 1
	ENDIF
RETURN

"RightHotSpot":
	IF CurveLeft[i] < ESP THEN
		HOTSPOT 0.5,  0, 0, unID, CurveRight[i], 1 : unID = unID + 1
		HOTSPOT 0.5,  0, 0, unID, CurveRight[i], 2 : unID = unID + 1
		HOTSPOT 0.5, -1, 0, unID, CurveRight[i], 3 : unID = unID + 1
	ENDIF
RETURN

"RightAngleHotSpot":
	IF CurveRight[i] < ESP THEN 
		centerX = 1 + CurveRight[i-1]
		centerY = 0
		RightRadius = CurveRight[i-1] - 1
		refX = centerX - RightRadius * COS(RightAngle[i])
		refY = centerY - RightRadius * SIN(RightAngle[i])
		HOTSPOT centerX,	centerY,	0, unID, RightAngle[i], 518 		: unID = unID + 1
		HOTSPOT refX,		refY,		0, unID, RightAngle[i], 4 + 128 	: unID = unID + 1
		HOTSPOT 1 + 1,	 	0,			0, unID, RightAngle[i], 5   		: unID = unID + 1
	ENDIF
RETURN

"LeftHotSpot":
	IF CurveRight[i] < ESP THEN
		HOTSPOT -0.5,  0, 0, unID, CurveLeft[i], 1 : unID = unID + 1
		HOTSPOT -0.5,  0, 0, unID, CurveLeft[i], 2 : unID = unID + 1
		HOTSPOT -0.5, -1, 0, unID, CurveLeft[i], 3 : unID = unID + 1
	ENDIF
RETURN

"LeftAngleHotSpot":
	IF CurveLeft[i] < ESP THEN 
		centerX = -CurveLeft[i-1]
		centerY = 0
		LeftRadius = CurveLeft[i-1] - 1 
		IF LeftAngle[i] >= 180 THEN LeftAngle[i] = LeftAngle[i] - 1
		refX = centerX + LeftRadius * COS(-LeftAngle[i])
		refY = centerY + LeftRadius * SIN(-LeftAngle[i])
		HOTSPOT centerX,	centerY,	0, unID,	LeftAngle[i], 6 		: unID = unID + 1
		HOTSPOT refX,   	refY,		0, unID,	LeftAngle[i], 4 + 128	: unID = unID + 1
		HOTSPOT -1,			0,			0, unID,	LeftAngle[i], 5 		: unID = unID + 1
	ENDIF
RETURN

"StraightHotSpot":
	IF NextLength[i] < -ESP THEN NextLength[i] = ESP
	HOTSPOT 0,  0,				0, unID, NextLength[i], 1 : unID = unID + 1
	HOTSPOT 0,  NextLength[i], 	0, unID, NextLength[i], 2 : unID = unID + 1
	HOTSPOT 0, -1,				0, unID, NextLength[i], 3 : unID = unID + 1
RETURN

!----------------------------------------------------------------------------------------------------------------------------------------
"LightTube":
	IF TopTubeVisible THEN
		MATERIAL TubeColor
		tubeRad = 0.03
		TUBE 17, NSP/4, 1+2,
			tubeRad * COS(0),    tubeRad * SIN(0),    1,
			tubeRad * COS(22.5), tubeRad * SIN(22.5), 1,
			tubeRad * COS(45),   tubeRad * SIN(45),   1,
			tubeRad * COS(67.5), tubeRad * SIN(67.5), 1,
			tubeRad * COS(90),   tubeRad * SIN(90),   1,
			tubeRad * COS(112.5),tubeRad * SIN(112.5),1,
			tubeRad * COS(135),  tubeRad * SIN(135),  1,
			tubeRad * COS(157.5),tubeRad * SIN(157.5),1,
			tubeRad * COS(180),  tubeRad * SIN(180),  1,
			tubeRad * COS(202.5),tubeRad * SIN(202.5),1,
			tubeRad * COS(225),  tubeRad * SIN(225),  1,
			tubeRad * COS(247.5),tubeRad * SIN(247.5),1,
			tubeRad * COS(270),  tubeRad * SIN(270),  1,
			tubeRad * COS(292.5),tubeRad * SIN(292.5),1,
			tubeRad * COS(315),  tubeRad * SIN(315),  1,
			tubeRad * COS(337.5),tubeRad * SIN(337.5),1,
			tubeRad * COS(0),    tubeRad * SIN(0),    1,
			GET(NSP)
		MATERIAL Asfalt
	ENDIF
RETURN
!----------------------------------------------------------------------------------------------------------------------------------------
]]>
</Script_3D>

