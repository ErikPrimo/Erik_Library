<Script_1D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
unID = 1
ESP = 0.000001
TrackColor = 22
TrackThickness = 0.01
ExtrudeValues =  1+2+4
CatWalkThickness = 1
