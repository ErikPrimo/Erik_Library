<![CDATA[
MATERIAL Asfalt
RESOL 64

!---------HOT SPOTS-------------------------------------------------------------------------------------------------------------------------------------------------------------
GOSUB "SizeAndShapeHotSpots"
GOSUB "EntryAngleHotSpot"
GOSUB "ExitAngleHotSpot"
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

!-----Main Area--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
EXTRUDE 17, 0, 0, TrackThickness, ExtrudeValues,
	0,					0,						1,
	Length,				0,						1,
	Length,				0 + RightRadi,			900,
	Length + RightRadi,	0 + RightRadi,			3001, 
	Length + RightRadi,	0 + RightRadi,			1,
	Length + RightRadi,	Width - RightRadi,		1,
	Length,				Width - RightRadi,		900,
	Length,				Width,					3001,
	Length,				Width,					1,
	0,					Width,					1,
	0,					Width - RightRadi,		900,
	-RightRadi,			Width - RightRadi,		3001,
	-RightRadi,			Width - RightRadi,		1,
	-RightRadi,			0 + RightRadi,			1,
	0,					0 + RightRadi,			900,
	0,					0,						3001,
	0,					0,						1
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

!------Entry And Exit-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
TrackWidth = RightRadi
ADDX Length
ADDY Width-TrackWidth
ROTZ -ExitAngle
GOSUB "ExitLengthHotSpot"
EXTRUDE 4, 0, 0, TrackThickness, ExtrudeValues,
	0,				0,				1,
	ExitLength,		0,				1,
	ExitLength,		TrackWidth,		1,
	0,				TrackWidth,		1
DEL 3
TrackWidth = RightRadi
ADDY Width-TrackWidth
ROTZ (90 - EntryAngle) + 180
GOSUB "EntryLengthHotSpot"
EXTRUDE 4, 0, 0, TrackThickness, ExtrudeValues,
	0,				0,				1,
	EntryLength,	0,				1,
	EntryLength,	-TrackWidth,	1,
	0,				-TrackWidth,	1
DEL 3
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

GOSUB "Pits"

END 

"Pits":
	MATERIAL 18
	ADDZ TrackThickness * 2
	ROTZ -90
	ADD -Width / 2, Length / 2, 0

	! --- DIMENSIONS ---
	BoxWidth       = 1.7 / 2     ! 0.85
	BoxHeight      = 0.70
	BoxMargin      = 0.40
	FrontLineWidth = 0.20
	SideLineWidth  = 0.10

	! --- INSTANT COUNT COMPUTATION ---
	StepX = BoxWidth * 2 + BoxMargin
	StepY = BoxHeight * 2 + BoxMargin * 2

	Rows  = MIN(20, MAX(0, INT(Width / (BoxWidth * 2 + BoxMargin * 2))))
	Lines = MIN(20,  MAX(0, INT((Length - 0.2) / (BoxHeight * 2 + BoxMargin * 2))))

	! --- STARTING LINE (TRANSVERSE) ---
	IF Lines > 0 AND Rows > 0 THEN
		! --- ALTERNATING ROWS (COLUMNS ACROSS TRACK) ---
		StartY = -(StepY * Lines) / 2
		StartX = -(StepX * Rows) / 2 + (StepX / 2)

		FOR j = 1 TO Rows
			curX = StartX + (j - 1) * StepX 

			IF j MOD 2 = NOT(1) THEN
				! --- ODD ROWS: VERTICAL COLUMN OF BOXES ALONG LENGTH ---
				FOR i = 1 TO Lines
					curY = StartY + (i - 1) * StepY +BoxHeight 
					ADD curX-BoxWidth, curY, 0
					BLOCK BoxWidth*2 , SideLineWidth, LineThickness 
					! EXTRUDE 8, 0, 0, LineThickness, ExtrudeValues,
					! 	-BoxWidth,                  0,                          1,
					! 	-BoxWidth,                  BoxHeight,                  1,
					! 	 BoxWidth,                  BoxHeight,                  1,
					! 	 BoxWidth,                  0,                          1,
					! 	 BoxWidth - SideLineWidth,  0,                          1,
					! 	 BoxWidth - SideLineWidth,  BoxHeight - FrontLineWidth, 1,
					! 	-BoxWidth + SideLineWidth,  BoxHeight - FrontLineWidth, 1,
					! 	-BoxWidth + SideLineWidth,  0,                          1
					DEL 1
				NEXT i
			ELSE
				! --- EVEN ROWS: CATWALK COLUMN (CENTERED ACROSS LENGTH) ---
				ADD curX, -Length/2, 0
				GOSUB "CatWalk"
				DEL 1
			ENDIF
		NEXT j
	ENDIF
	DEL 3   ! Restores ADD, ROTZ, ADDZ
	MATERIAL Asfalt
RETURN

"CatWalk":
	ROTZ 90
	MATERIAL 19
	EXTRUDE 17, 0, 0, .2, ExtrudeValues,
		0,							-CatWalkThickness/2,						1,
		CatWalkLength,				-CatWalkThickness/2,						1,
		CatWalkLength,				-CatWalkThickness/2 + CatWalkRadi,			900,  
		CatWalkLength + CatWalkRadi,-CatWalkThickness/2 + CatWalkRadi,			3001, 
		CatWalkLength + CatWalkRadi,-CatWalkThickness/2 + CatWalkRadi,			1,
		CatWalkLength + CatWalkRadi, CatWalkThickness/2 - CatWalkRadi,			1,
		CatWalkLength,				 CatWalkThickness/2 - CatWalkRadi,			900,  
		CatWalkLength,	 			 CatWalkThickness/2,						3001,
		CatWalkLength,				 CatWalkThickness/2,						1,
		0,							 CatWalkThickness/2,						1,
		0,							 CatWalkThickness/2 - CatWalkRadi,			900,  
		-CatWalkRadi,				 CatWalkThickness/2 - CatWalkRadi,			3001,
		-CatWalkRadi,				 CatWalkThickness/2 - CatWalkRadi,			1,
		-CatWalkRadi,				-CatWalkThickness/2 + CatWalkRadi,			1,
		0,							-CatWalkThickness/2 + CatWalkRadi,			900,  
		0,							-CatWalkThickness/2,						3001,
		0,							-CatWalkThickness/2,						1
	MATERIAL 18
	DEL 1
RETURN

!---------HOT SPOTS-------------------------------------------------------------------------------------------------------------------------------------------------------------
"SizeAndShapeHotSpots":
	HOTSPOT   0,	0,	0, unID, Length, 1 : unID = unID + 1
	HOTSPOT   0,	0,	0, unID, Length, 2 : unID = unID + 1
	HOTSPOT  -1,	0,	0, unID, Length, 3 : unID = unID + 1

	HOTSPOT   0,	0,	0, unID, Width, 1 : unID = unID + 1
	HOTSPOT   0,	0,	0, unID, Width, 2 : unID = unID + 1
	HOTSPOT   0,	-1,	0, unID, Width, 3 : unID = unID + 1

	HOTSPOT   0,	Width,	0, unID, RightRadi, 1 : unID = unID + 1
	HOTSPOT   0,	Width,	0, unID, RightRadi, 2 : unID = unID + 1
	HOTSPOT   0,	Width + 1,	0, unID, RightRadi, 3 : unID = unID + 1
RETURN


"ExitAngleHotSpot":
	HOTSPOT Length,		Width - RightRadi,	0, unID, ExitAngle, 518        : unID = unID + 1
	HOTSPOT Length + 2,	Width - RightRadi,	0, unID, ExitAngle, 4 + 128    : unID = unID + 1
	HOTSPOT Length,		Width/2,			0, unID, ExitAngle, 5          : unID = unID + 1
RETURN

"EntryAngleHotSpot":
	ADD2 0, Width - RightRadi
	ROT2 90
	HOTSPOT  0,	0,				0, unID, EntryAngle, 518		: unID = unID + 1
	HOTSPOT -2,	0,				0, unID, EntryAngle, 4 + 128	: unID = unID + 1
	DEL 2
	HOTSPOT  0,	Width/2,		0, unID, EntryAngle, 5			: unID = unID + 1
RETURN

"ExitLengthHotSpot":
	HOTSPOT  0,              TrackWidth / 2, 0, unID, ExitLength, 1 : unID = unID + 1
	HOTSPOT  ExitLength,     TrackWidth / 2, 0, unID, ExitLength, 2 : unID = unID + 1
	HOTSPOT -1,              TrackWidth / 2, 0, unID, ExitLength, 3 : unID = unID + 1
RETURN

"EntryLengthHotSpot":
	HOTSPOT  0,             -TrackWidth / 2, 0, unID, EntryLength, 1 : unID = unID + 1
	HOTSPOT  EntryLength,   -TrackWidth / 2, 0, unID, EntryLength, 2 : unID = unID + 1
	HOTSPOT -1,             -TrackWidth / 2, 0, unID, EntryLength, 3 : unID = unID + 1
RETURN
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
]]>
</Script_3D>

