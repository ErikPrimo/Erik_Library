<Script_3D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
MATERIAL Asfalt
RESOL 64

!---------HOT SPOTS-------------------------------------------------------------------------------------------------------------------------------------------------------------
GOSUB "SizeHotSpots"
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

!-----Main Area--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
EXTRUDE 17, 0, 0, TrackThickness, ExtrudeValues,
	0,					0,						1,
	Length,				0,						1,
	Length,				0 + PitRadi,			900,
	Length + PitRadi,	0 + PitRadi,			3001, 
	Length + PitRadi,	0 + PitRadi,			1,
	Length + PitRadi,	Width - PitRadi,		1,
	Length,				Width - PitRadi,		900,
	Length,				Width,					3001,
	Length,				Width,					1,
	0,					Width,					1,
	0,					Width - PitRadi,		900,
	-PitRadi,			Width - PitRadi,		3001,
	-PitRadi,			Width - PitRadi,		1,
	-PitRadi,			0 + PitRadi,			1,
	0,					0 + PitRadi,			900,
	0,					0,						3001,
	0,					0,						1
ADDZ TrackThickness
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

FOR i = 1 TO SegmentNum
	IF SegmentOrder[i] = 1 THEN GOSUB "CatWalk"
	IF SegmentOrder[i] = 2 THEN GOSUB "PitBox"
	IF SegmentOrder[i] = 3 THEN GOSUB "Space"
NEXT i
END

"PitBox":
	MATERIAL 753
    ADDZ TrackThickness  ! Position the pit box geometry directly on top of the base track
    ADDY PitBoxMargin
    ADDX PitBoxMargin
    ActualBoxWidth = SegmentWidthPit[i] - PitBoxMargin * 2
    FOR j = 1 TO SegmentCount
        PRISM_ 9, PitBoxHeight,
            0,              0,                              1,
            PitBoxLength,   0,                              1,
            PitBoxLength,   PitBoxLine,                     1,
            PitBoxLine,     PitBoxLine,                     1,
            PitBoxLine,     ActualBoxWidth - PitBoxLine,    1,
            PitBoxLength,   ActualBoxWidth - PitBoxLine,    1,
            PitBoxLength,   ActualBoxWidth,                 1,
            0,              ActualBoxWidth,                 1,
            0,              0,                              1

        ADDX PitBoxLength
    NEXT j
    PRISM_ 5, PitBoxHeight,
        0,          0,              1,
        PitBoxLine, 0,              1,
        PitBoxLine, ActualBoxWidth, 1,
        0,          ActualBoxWidth, 1,
        0,          0,              1
    DEL 3 + SegmentCount
    ADDY SegmentWidthPit[i]
RETURN

"CatWalk":
	!GOSUB "CatRightHotSpots"
	!GOSUB "CatLeftHotSpots"
	!GOSUB "RightRadiHotSpots"
	!GOSUB "LeftRadiHotSpots"
	!GOSUB "RightRadiDirectionHotSpots"
	ADDY SegmentWidthCat[i] / 2
	CatWalkWidth = SegmentWidthCat[i]
	UpperPlateThickness = 0.05
	CatWalkThickness = 0.2
	MATERIAL CatColor[i]
	ADDZ CatWalkThickness - UpperPlateThickness
	Thicnkess = UpperPlateThickness
	GOSUB "CatWalkGeometry"
	DEL 1
	CatWalkWidth = SegmentWidthCat[i]*0.8
	MATERIAL Asfalt
	Thicnkess = CatWalkThickness - UpperPlateThickness
	GOSUB "CatWalkGeometry"
	DEL 1
	ADDY SegmentWidthCat[i]
RETURN

"CatWalkGeometry":
	RightRadiSt = RightRadi[i]
	LeftRadiSt = LeftRadi[i]
	R_InnerRadi = RightRadiSt - CatWalkWidth/2
	R_OuterRadi = RightRadiSt + CatWalkWidth/2
	L_InnerRadi = LeftRadiSt - CatWalkWidth/2
	L_OuterRadi = LeftRadiSt + CatWalkWidth/2
	IF RightRadiDirection[i] > ESP THEN
		R_Direction = -1
	ELSE
		R_Direction = 1
	ENDIF
	IF LeftRadiDirection[i] > ESP THEN
		L_Direction = -1
	ELSE
		L_Direction = 1
	ENDIF
	!GOSUB "AngleRightHotSpot"
	!GOSUB "AngleLeftHotSpot"

	EXTRUDE 13, 0, 0, Thicnkess, ExtrudeValues,
		CatLeft[i],					 											R_Direction * CatWalkWidth/2,															1,				!1
		CatWalkLength + CatRight[i],											R_Direction * CatWalkWidth/2,															1,				!2
		CatWalkLength + CatRight[i],											R_Direction * RightRadiSt,																900,			!3
		CatWalkLength + CatRight[i] + R_InnerRadi * SIN(AngleRight[i]),			R_Direction * R_InnerRadi * (1 - COS(AngleRight[i]))-(CatWalkWidth/2)*(-R_Direction),	3000,			!4
		CatWalkLength + CatRight[i] + R_InnerRadi * SIN(AngleRight[i]),			R_Direction * R_InnerRadi * (1 - COS(AngleRight[i]))-(CatWalkWidth/2)*(-R_Direction),	1,				!5
		CatWalkLength + CatRight[i] + RightRadiSt * SIN(AngleRight[i]),			R_Direction * RightRadiSt * (1 - COS(AngleRight[i])),									900,			!6
		0,																		-R_Direction * 180,																		4000,			!7
		CatWalkLength + CatRight[i] + R_OuterRadi * SIN(AngleRight[i]),			R_Direction * R_OuterRadi * (1 - COS(AngleRight[i]))+(CatWalkWidth/2)*(-R_Direction),	1,				!8
		CatWalkLength + CatRight[i],											R_Direction * RightRadiSt,																900,			!9
		CatWalkLength + CatRight[i],											-R_Direction * CatWalkWidth/2,															3000,			!10
		CatWalkLength + CatRight[i],											-R_Direction * CatWalkWidth/2,															1,				!11
		CatLeft[i],																-R_Direction * CatWalkWidth/2,															1,				!12
		CatLeft[i],																R_Direction * CatWalkWidth/2,															1				!13
	EXTRUDE 11, 0, 0, Thicnkess, ExtrudeValues,
		CatLeft[i],																-L_Direction * CatWalkWidth/2,															1,				!1
		CatLeft[i],																L_Direction * CatWalkWidth/2,															1,				!2
		CatLeft[i],																L_Direction * LeftRadiSt,																900,			!3
		CatLeft[i] - L_InnerRadi * SIN(AngleLeft[i]),							L_Direction * L_InnerRadi * (1 - COS(AngleLeft[i]))-(CatWalkWidth/2)*(-L_Direction),	3000,			!4
		CatLeft[i] - L_InnerRadi * SIN(AngleLeft[i]),							L_Direction * L_InnerRadi * (1 - COS(AngleLeft[i]))-(CatWalkWidth/2)*(-L_Direction),	1,				!5
		CatLeft[i] - LeftRadiSt * SIN(AngleLeft[i]),							L_Direction * LeftRadiSt * (1 - COS(AngleLeft[i])),										900,			!6
		0,																		L_Direction * 180,																		4000,			!7
		CatLeft[i] - L_OuterRadi * SIN(AngleLeft[i]),							L_Direction * L_OuterRadi * (1 - COS(AngleLeft[i]))+(CatWalkWidth/2)*(-L_Direction),	1,				!8
		CatLeft[i],																L_Direction * LeftRadiSt,																900,			!9
		CatLeft[i],																-L_Direction * CatWalkWidth/2,															3000,			!10
		CatLeft[i],																-L_Direction * CatWalkWidth/2,															1				!11
RETURN

"Space":
	ADDY SegmentWidthSpace[i]
RETURN

!---------HOT SPOTS-------------------------------------------------------------------------------------------------------------------------------------------------------------
"SizeHotSpots":
	HOTSPOT   0,	0,	0, unID, Length, 1 : unID = unID + 1
	HOTSPOT   0,	0,	0, unID, Length, 2 : unID = unID + 1
	HOTSPOT  -1,	0,	0, unID, Length, 3 : unID = unID + 1
RETURN

"CatRightHotSpots":
	ADDY SegmentWidthCat[i] / 2
	HOTSPOT		CatWalkLength,		0,	0, unID, CatRight[i], 1 : unID = unID + 1
	HOTSPOT		CatWalkLength,		0,	0, unID, CatRight[i], 2 : unID = unID + 1
	HOTSPOT		CatWalkLength-1,	0,	0, unID, CatRight[i], 3 : unID = unID + 1
	DEL 1
RETURN

"CatLeftHotSpots":
	ADDY SegmentWidthCat[i] / 2
	HOTSPOT		0,		0,	0, unID, CatLeft[i], 1 : unID = unID + 1
	HOTSPOT		0,		0,	0, unID, CatLeft[i], 2 : unID = unID + 1
	HOTSPOT		-1,		0,	0, unID, CatLeft[i], 3 : unID = unID + 1
	DEL 1
RETURN

"RightRadiHotSpots":
	ADDY SegmentWidthCat[i] / 2
	ADDX CatWalkLength + SegmentWidthCat[i]/2
	HOTSPOT		0,		0,	0, unID, RightRadi[i], 1 : unID = unID + 1
	HOTSPOT		0,		0,	0, unID, RightRadi[i], 2 : unID = unID + 1
	HOTSPOT		-1,		0,	0, unID, RightRadi[i], 3 : unID = unID + 1
	DEL 2
RETURN

"LeftRadiHotSpots":
	ADDY SegmentWidthCat[i] / 2
	ADDX -SegmentWidthCat[i]/2
	HOTSPOT		0,		0,	0, unID, LeftRadi[i], 1 : unID = unID + 1
	HOTSPOT		0,		0,	0, unID, LeftRadi[i], 2 : unID = unID + 1
	HOTSPOT		1,		0,	0, unID, LeftRadi[i], 3 : unID = unID + 1
	DEL 2
RETURN

"RightRadiDirectionHotSpots":
	ADDY SegmentWidthCat[i] / 2
	ADDX CatWalkLength + SegmentWidthCat[i]/2
	HOTSPOT		0,		 0,		0, unID, RightRadiDirection[i], 1 : unID = unID + 1
	HOTSPOT		0,		 0,		0, unID, RightRadiDirection[i], 2 : unID = unID + 1
	HOTSPOT		0,		 1,		0, unID, RightRadiDirection[i], 3 : unID = unID + 1
	DEL 2
RETURN

"AngleRightHotSpot":
	IF R_Direction < -ESP THEN : AngleNum = 518 : ELSE : AngleNum = 6 : ENDIF
	IF RightRadi[i] > ESP THEN
		HOTSPOT		CatWalkLength,					R_Direction*RightRadiSt,			0, unID, AngleRight[i], AngleNum	: unID = unID + 1
		HOTSPOT		CatWalkLength+RightRadiSt,		R_Direction*RightRadiSt,			0, unID, AngleRight[i], 5			: unID = unID + 1
		HOTSPOT		CatWalkLength,					0,									0, unID, AngleRight[i], 4			: unID = unID + 1
	ENDIF
RETURN

"AngleLeftHotSpot":
	IF L_Direction < -ESP THEN : AngleNum = 518 : ELSE : AngleNum = 6 : ENDIF
	!IF LeftRadi[i] > ESP THEN
		HOTSPOT		0,					L_Direction*LeftRadiSt,	0, unID, AngleLeft[i], AngleNum		: unID = unID + 1
		HOTSPOT		-LeftRadiSt,		L_Direction*LeftRadiSt,	0, unID, AngleLeft[i], 5			: unID = unID + 1
		HOTSPOT		0,					0,						0, unID, AngleLeft[i], 4			: unID = unID + 1
	!ENDIF
RETURN
!-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
]]>
</Script_3D>

