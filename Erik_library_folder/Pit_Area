ENDIF
!------------------------------------------------------------------------------------------------------------------------------------------


FOR i = 1 TO 15
	IF AngleRight[i] < ESP THEN AngleRight[i] = 50
	IF AngleLeft[i] < ESP THEN AngleLeft[i] = 50
NEXT i
SegmentNum = 1

WHILE SegmentOrder[SegmentNum] <> 0 DO
	IF SegmentOrder[SegmentNum] = 1 THEN Width = Width + SegmentWidthCat[SegmentNum]
	IF SegmentOrder[SegmentNum] = 2 THEN Width = Width + SegmentWidthPit[SegmentNum]
	IF SegmentOrder[SegmentNum] = 3 THEN Width = Width + SegmentWidthSpace[SegmentNum]
	SegmentNum = SegmentNum + 1
ENDWHILE

PitRadi = Width/3
IF PitRadi < 5.2 AND Width/2 > 5.2 THEN PitRadi = 5.2
]]>
</Script_1D>

