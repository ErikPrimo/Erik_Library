PitBoxMargin = 0.05
PitBoxLine = 0.1
PitBoxLength = 2.2

ColorCircles = 1
CircleSize = 0.1
LibraryBool = LIBRARYGLOBAL ("LibraryGlobals_Karting", "ColorCircles", ColorCircles)
LibraryBool = LIBRARYGLOBAL ("LibraryGlobals_Karting", "CircleSize", CircleSize)

Width = 0
!------While Being Edited Show Outline------------------------------------------------------------------------------------------------------------------------------------
