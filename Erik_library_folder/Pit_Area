	IF SegmentOrder[i] = 2 THEN UI_INFIELD{2} SegmentWidthPit[i],			220, Y_Offset + 7, 60, 20
	IF SegmentOrder[i] = 3 THEN UI_INFIELD{2} SegmentWidthSpace[i],			220, Y_Offset + 7, 60, 20
