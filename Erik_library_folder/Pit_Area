<Script_2D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
SET FILL "Solid Fill"
PEN 1
PROJECT2{3} 3, 270, 3 + 16, 4 + 8

!--------- 2D HOT SPOTS -------------------------------------------------------------------------------------------------------------------------
GOSUB "SizeHotSpots"
!------------------------------------------------------------------------------------------------------------------------------------------------

! !----- Main Area --------------------------------------------------------------------------------------------------
! POLY2_B 15, 1 + 2 + 4,
! 		TrackColor, 0,
! 		0, 						0,					1,
! 		Length, 				0,					1,
! 		Length, 				PitRadi,			900,
! 		0, 						90,					4001,
! 		Length + PitRadi,		Width - PitRadi,	1,
! 		Length,					Width - PitRadi,	900,
! 		0,						90,					4001,
! 		0,						Width,				1,
! 		0,						Width - PitRadi,	900,
! 		0,						90,					4001,
! 		-PitRadi,				PitRadi,			1,
! 		0,						PitRadi,			900,
! 		0,						90,					4001,
! 		0,						0,					1,
! 		0,						0,					-1
! !------------------------------------------------------------------------------------------------------------------------------------------------
	FOR i = 1 TO SegmentNum
		IF SegmentOrder[i] = 1 THEN GOSUB "CatWalk"
		IF SegmentOrder[i] = 2 THEN GOSUB "PitBox"
		IF SegmentOrder[i] = 3 THEN GOSUB "Space"
	NEXT i
END

"PitBox":
	! ADD2 PitBoxMargin, PitBoxMargin
	! ActualBoxWidth = SegmentWidthPit[i] - PitBoxMargin*2
	! FOR j = 1 TO SegmentCount
	! 	POLY2_B 9, 1 + 2 + 4,
	! 			19, 0,
	! 			0,				0,								1,
	! 			PitBoxLength,	0,								1,
	! 			PitBoxLength,	PitBoxLine,						1,
	! 			PitBoxLine,		PitBoxLine,						1,
	! 			PitBoxLine,		ActualBoxWidth - PitBoxLine,	1,
	! 			PitBoxLength,	ActualBoxWidth - PitBoxLine,	1,
	! 			PitBoxLength,	ActualBoxWidth,					1,
	! 			0,				ActualBoxWidth,					1,
	! 			0,				0,								1
	! 	ADD2 PitBoxLength, 0
	! NEXT j
	! POLY2_B 5, 1 + 2 + 4,
	! 	19,	0,
	! 	0,			0,				1,
	! 	PitBoxLine,	0,				1,
	! 	PitBoxLine,	ActualBoxWidth,	1,
	! 	0,			ActualBoxWidth,	1,
	! 	0,			0,				1
	! DEL 1 + SegmentCount
	ADD2 0, SegmentWidthPit[i]
RETURN

"CatWalk":
	ADD2 0, SegmentWidthCat[i] / 2
	! IF RightRadiSt < ESP THEN RightRadiSt = ESP
	! IF LeftRadiSt < ESP THEN LeftRadiSt = ESP
	RightRadiSt = RightRadi[i]
	LeftRadiSt = LeftRadi[i]
	GOSUB "CatRightHotSpots"
	ADD2 CatRight[i], 0
	GOSUB "RightRadiHotSpots"
	GOSUB "RightRadiDirectionHotSpots"
	IF RightRadiDirection[i] > ESP THEN
		R_Direction = -1
	ELSE
		R_Direction = 1
	ENDIF
	GOSUB "AngleRightHotSpot"
	DEL 1
	GOSUB "CatLeftHotSpots"
	ADD2 CatLeft[i], 0
	GOSUB "LeftRadiHotSpots"
	GOSUB "LeftRadiDirectionHotSpots"
	IF LeftRadiDirection[i] > ESP THEN
		L_Direction = -1
	ELSE
		L_Direction = 1
	ENDIF
	GOSUB "AngleLeftHotSpot"
	DEL 1
	! CatWalkWidth = SegmentWidthCat[i]
	! POLY2_B 17, 1 + 2 + 4,
	! 	CatColor[i], 0,
	! 	0,													-CatWalkWidth/2,					1,
	! 	CatWalkLength + CatRight[i],						-CatWalkWidth/2,					1,
	! 	CatWalkLength + CatRight[i],						-CatWalkWidth/2 + CatWalkWidth/2,	900,
	! 	CatWalkLength + CatRight[i] + CatWalkWidth/2,		-CatWalkWidth/2 + CatWalkWidth/2,	3001,
	! 	CatWalkLength + CatRight[i] + CatWalkWidth/2,		-CatWalkWidth/2 + CatWalkWidth/2,	1,
	! 	CatWalkLength + CatRight[i] + CatWalkWidth/2,		CatWalkWidth/2 - CatWalkWidth/2,	1,
	! 	CatWalkLength + CatRight[i],						CatWalkWidth/2 - CatWalkWidth/2,	900,
	! 	CatWalkLength + CatRight[i],						CatWalkWidth/2,						3001,
	! 	CatWalkLength + CatRight[i],						CatWalkWidth/2,						1,
	! 	0,													CatWalkWidth/2,						1,
	! 	0,													CatWalkWidth/2 - CatWalkWidth/2,	900,
	! 	-CatWalkWidth/2,									CatWalkWidth/2 - CatWalkWidth/2,	3001,
	! 	-CatWalkWidth/2,									CatWalkWidth/2 - CatWalkWidth/2,	1,
	! 	-CatWalkWidth/2,									-CatWalkWidth/2 + CatWalkWidth/2,	1,
	! 	0,													-CatWalkWidth/2 + CatWalkWidth/2,	900,
	! 	0,													-CatWalkWidth/2,					3001,
	! 	0,													-CatWalkWidth/2,					1
	DEL 1
	ADD2 0, SegmentWidthCat[i]
RETURN

"Space":
	ADD2 0, SegmentWidthSpace[i]
RETURN

!--------- 2D HOT SPOTS -------------------------------------------------------------------------------------------------------------------------
"SizeHotSpots":
	HOTSPOT2	 0,	0, unID, Length, 1 : unID = unID + 1
	HOTSPOT2	 0,	0, unID, Length, 2 : unID = unID + 1
	HOTSPOT2	-1,	0, unID, Length, 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			80, 0,
			0,             0, 900,
			CircleSize,               360, 4001

		! Larger arrow pointing to the right
		arrX = CircleSize + 0.06
		arrLen = 0.15
		arrSize = 0.06
		LINE2 arrX, 0, arrX + arrLen, 0
		LINE2 arrX + arrLen, 0, arrX + arrLen - arrSize, arrSize
		LINE2 arrX + arrLen, 0, arrX + arrLen - arrSize, -arrSize
	ENDIF
RETURN

"CatRightHotSpots":
	HOTSPOT2	CatRight[i] + CatWalkLength,		0,	unID, CatRight[i], 1 : unID = unID + 1
	HOTSPOT2	CatRight[i] + CatWalkLength,		0,	unID, CatRight[i], 2 : unID = unID + 1
	HOTSPOT2	CatRight[i] + CatWalkLength-1,		0,	unID, CatRight[i], 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			4, 0,
			CatRight[i] + CatWalkLength, 0, 900,
			CircleSize, 360, 4001
	ENDIF
RETURN

"CatLeftHotSpots":
	HOTSPOT2	CatLeft[i],		0, unID, CatLeft[i], 1 : unID = unID + 1
	HOTSPOT2	CatLeft[i],		0, unID, CatLeft[i], 2 : unID = unID + 1
	HOTSPOT2	CatLeft[i]-1,	0, unID, CatLeft[i], 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			4, 0,
			CatLeft[i], 0, 900,
			CircleSize, 360, 4001
	ENDIF
RETURN

"RightRadiHotSpots":
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2,		0, unID, RightRadi[i], 1 : unID = unID + 1
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2,		0, unID, RightRadi[i], 2 : unID = unID + 1
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2-1,		0, unID, RightRadi[i], 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			8, 0,
			CatWalkLength + SegmentWidthCat[i]/2, 0, 900,
			CircleSize, 360, 4001
	ENDIF
RETURN

"LeftRadiHotSpots":
	HOTSPOT2		-SegmentWidthCat[i]/2,			0,	unID, LeftRadi[i], 1 : unID = unID + 1
	HOTSPOT2		-SegmentWidthCat[i]/2,			0,	unID, LeftRadi[i], 2 : unID = unID + 1
	HOTSPOT2		-SegmentWidthCat[i]/2+1,		0,	unID, LeftRadi[i], 3 : unID = unID + 1
	IF ColorCircles THEN
		POLY2_B 2, 1+2+4,
			8, 0,
			-SegmentWidthCat[i]/2, 0, 900,
			CircleSize, 360, 4001
	ENDIF
RETURN

"RightRadiDirectionHotSpots":
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2,		0, unID, RightRadiDirection[i], 1 : unID = unID + 1
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2,		0, unID, RightRadiDirection[i], 2 : unID = unID + 1
	HOTSPOT2	CatWalkLength + SegmentWidthCat[i]/2,		1, unID, RightRadiDirection[i], 3 : unID = unID + 1
RETURN

"LeftRadiDirectionHotSpots":
	HOTSPOT2	-SegmentWidthCat[i]/2,		0, unID, LeftRadiDirection[i], 1 : unID = unID + 1
	HOTSPOT2	-SegmentWidthCat[i]/2,		0, unID, LeftRadiDirection[i], 2 : unID = unID + 1
	HOTSPOT2	-SegmentWidthCat[i]/2,		1, unID, LeftRadiDirection[i], 3 : unID = unID + 1
RETURN

"AngleRightHotSpot":
	IF R_Direction < -ESP THEN : AngleNum = 518 : ELSE : AngleNum = 6 : ENDIF
	IF RightRadi[i] > ESP THEN
		HOTSPOT2	CatWalkLength,										R_Direction * RightRadiSt,								unID, AngleRight[i], AngleNum	: unID = unID + 1
		HOTSPOT2	CatWalkLength + RightRadiSt * SIN(AngleRight[i]),	R_Direction * RightRadiSt * (1 - COS(AngleRight[i])),	unID, AngleRight[i], 5			: unID = unID + 1
		HOTSPOT2	CatWalkLength,										0,														unID, AngleRight[i], 4			: unID = unID + 1
		IF ColorCircles THEN
			POLY2_B 2, 1+2+4,
				6, 0,
				CatWalkLength + RightRadiSt * SIN(AngleRight[i]), R_Direction * RightRadiSt * (1 - COS(AngleRight[i])), 900,
				CircleSize, 360, 4001
		ENDIF
	ENDIF

RETURN

"AngleLeftHotSpot":
	IF L_Direction < -ESP THEN : AngleNum = 6 : ELSE : AngleNum = 518 : ENDIF
	EPS= 0.0000001
	IF LeftRadi[i] > ESP THEN
		HOTSPOT2	0,												L_Direction * LeftRadiSt,								unID, AngleLeft[i], AngleNum	: unID = unID + 1
		HOTSPOT2	-LeftRadiSt * SIN(AngleLeft[i]),				L_Direction * LeftRadiSt * (1 - COS(AngleLeft[i])),		unID, AngleLeft[i], 5			: unID = unID + 1
		HOTSPOT2	0,												0,														unID, AngleLeft[i], 4			: unID = unID + 1
		IF ColorCircles THEN
			POLY2_B 2, 1+2+4,
				6, 0,
				-LeftRadiSt * SIN(AngleLeft[i]),	L_Direction * LeftRadiSt * (1 - COS(AngleLeft[i])), 900,
				CircleSize, 360, 4001
		ENDIF
	ENDIF
RETURN
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
]]>
</Script_2D>

